# Copy to .env (never commit .env). All values are server-side unless prefixed NEXT_PUBLIC_.

CIT_ENV=production
CIT_DOMAIN=cit.example.com
CIT_PUBLIC_URL=https://cit.example.com

# --- Database (Supabase) -----------------------------------------------------
# Privileged connection for workers/API only. Use the Supabase *session* pooler
# (port 5432) or direct connection. If you use the transaction pooler (6543),
# set CIT_DATABASE_DISABLE_PREPARED_STATEMENTS=true.
CIT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
CIT_DATABASE_DISABLE_PREPARED_STATEMENTS=false

# Browser-safe Supabase values (anon key is public by design; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Internal API ---------------------------------------------------------------
# Shared secret between the Next.js server and the internal API. Generate with:
#   openssl rand -hex 32
CIT_INTERNAL_API_TOKEN=

# --- Optional providers (features degrade gracefully when empty) ----------------
CIT_GOPLUS_APP_KEY=
CIT_GOPLUS_APP_SECRET=
CIT_ANTHROPIC_API_KEY=
CIT_TELEGRAM_BOT_TOKEN=
CIT_TELEGRAM_ALERT_CHAT_ID=
CIT_ALCHEMY_API_KEY=
CIT_HELIUS_API_KEY=

# --- Ops -------------------------------------------------------------------------
CIT_LOG_LEVEL=INFO
CIT_GLOBAL_RATE_LIMIT_PER_MINUTE=120
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=19
